@article{easterling_etal1997MaximumMinimum,
  title = {Maximum and {{Minimum Temperature Trends}} for the {{Globe}}},
  author = {Easterling, David R. and Horton, Briony and Jones, Philip D. and Peterson, Thomas C. and Karl, Thomas R. and Parker, David E. and Salinger, M. James and Razuvayev, Vyacheslav and Plummer, Neil and Jamason, Paul and Folland, Christopher K.},
  date = {1997-07-18},
  journaltitle = {Science},
  volume = {277},
