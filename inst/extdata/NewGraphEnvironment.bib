@article{granjeiro_etal2025FutureScientific,
  title = {The {{Future}} of {{Scientific Writing}}: {{AI Tools}}, {{Benefits}}, and {{Ethical Implications}}},
  shorttitle = {The {{Future}} of {{Scientific Writing}}},
  author = {Granjeiro, José Mauro and Cury, Altair Antoninha Del Bel and Cury, Jaime Aparecido and Bueno, Mike and Sousa-Neto, Manoel Damião and Estrela, Carlos},
  date = {2025},
  journaltitle = {Brazilian Dental Journal},
  shortjournal = {Braz. Dent. J.},
  volume = {36},
  pages = {e25-6471},
  issn = {1806-4760, 0103-6440},
  doi = {10.1590/0103-644020256471},
  url = {http://www.scielo.br/scielo.php?script=sci_arttext&pid=S0103-64402025000100201&tlng=en},
  urldate = {2026-02-12},
  abstract = {Abstract Artificial Intelligence (AI) transforms scientific writing by improving efficiency, accessibility, and quality. This study evaluated the applications, benefits, and challenges of AI tools, including Elicit, Perplexity, Consensus, ChatGPT, and Grammarly, in the literature review, information organization, and textual clarity enhancement. A narrative review and practical analysis were conducted, assessing the tools based on synthesis capabilities, accessibility, and accuracy. Results showed that AI tools optimize literature analysis and enhance the clarity of scientific texts, particularly for non-native English-speaking researchers. However, limitations include technical inaccuracies, excessive standardization of writing style, and ethical concerns regarding authorship and accountability. The study concludes that while AI can significantly support scientific writing, its adoption should be accompanied by stringent human oversight and adherence to ethical guidelines to maintain academic integrity.           ,              Resumo A inteligência artificial (IA) está transformando a escrita científica, promovendo maior eficiência, acessibilidade e qualidade. Este estudo teve como objetivo avaliar as aplicações, benefícios e desafios de ferramentas de IA, como Elicit, Perplexity, Consensus, ChatGPT e Grammarly, na revisão de literatura, organização de informações e melhoria da clareza textual. Foi realizada uma revisão narrativa e uma análise prática das ferramentas, avaliando critérios como capacidade de síntese, acessibilidade e precisão. Os resultados demonstraram que as ferramentas de IA otimizam a análise de literatura e melhoram a clareza de textos científicos, especialmente para pesquisadores não nativos na língua inglesa. No entanto, foram identificadas limitações, como imprecisões técnicas, padronização excessiva do estilo de escrita e preocupações éticas relativas à autoria e à responsabilidade. Conclui-se que, embora a IA possa apoiar significativamente a escrita científica, sua adoção deve ser acompanhada de uma rigorosa supervisão humana e de diretrizes éticas para garantir a integridade acadêmica.},
  file = {/Users/airvine/Zotero/storage/528IDZZ6/granjeiro_2025_bdj.pdf}
}

