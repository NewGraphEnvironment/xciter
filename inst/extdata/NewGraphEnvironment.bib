@article{moore_schindler2022Gettingahead,
  title = {Getting Ahead of Climate Change for Ecological Adaptation and Resilience},
  author = {Moore, Jonathan W. and Schindler, Daniel E.},
  date = {2022-06-24},
  journaltitle = {Science},
  volume = {376},
  number = {6600},
  pages = {1421--1426},
  publisher = {American Association for the Advancement of Science},
  doi = {10.1126/science.abo3608},
  url = {https://www.science.org/doi/full/10.1126/science.abo3608},
  urldate = {2024-06-25},
  abstract = {Changing the course of Earth’s climate is increasingly urgent, but there is also a concurrent need for proactive stewardship of the adaptive capacity of the rapidly changing biosphere. Adaptation ultimately underpins the resilience of Earth’s complex systems; species, communities, and ecosystems shift and evolve over time. Yet oncoming changes will seriously challenge current natural resource management and conservation efforts. We review forward-looking conservation approaches to enable adaptation and resilience. Key opportunities include expanding beyond preservationist approaches by including those that enable and facilitate ecological change. Conservation should not just focus on climate change losers but also on proactive management of emerging opportunities. Local efforts to conserve biodiversity and generate habitat complexity will also help to maintain a diversity of future options for an unpredictable future.},
  file = {/Users/airvine/Zotero/storage/6EMQ27RT/Moore and Schindler - 2022 - Getting ahead of climate change for ecological ada.pdf}
}

@article{mora_etal2013projectedtiming,
  title = {The Projected Timing of Climate Departure from Recent Variability},
  author = {Mora, Camilo and Frazier, Abby and Longman, R. and Dacks, Rachel and Walton, Maya and Tong, Eric and Sanchez, Joseph and Kaiser, Lauren and Stender, Yuko and Anderson, James and Ambrosino, Christine and Fernandez-Silva, Iria and Giuseffi, Louise and Giambelluca, Thomas},
  date = {2013-10-09},
  journaltitle = {Nature},
  shortjournal = {Nature},
  volume = {502},
  pages = {183--187},
  doi = {10.1038/nature12540},
  abstract = {Ecological and societal disruptions by modern climate change are critically determined by the time frame over which climates shift beyond historical analogues. Here we present a new index of the year when the projected mean climate of a given location moves to a state continuously outside the bounds of historical variability under alternative greenhouse gas emissions scenarios. Using 1860 to 2005 as the historical period, this index has a global mean of 2069 (±18 years s.d.) for near-surface air temperature under an emissions stabilization scenario and 2047 (±14 years s.d.) under a 'business-as-usual' scenario. Unprecedented climates will occur earliest in the tropics and among low-income countries, highlighting the vulnerability of global biodiversity and the limited governmental capacity to respond to the impacts of climate change. Our findings shed light on the urgency of mitigating greenhouse gas emissions if climates potentially harmful to biodiversity and society are to be prevented.},
  file = {/Users/airvine/Zotero/storage/36G25ZK9/mora_et_al._2013-the_projected_timing.pdf}
}

