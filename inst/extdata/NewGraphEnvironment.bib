@article{matzinger_etal2007Effectsimpoundmenta,
  title = {Effects of Impoundment on Nutrient Availability and Productivity in Lakes},
  author = {Matzinger, Andreas and Pieters, Roger and Ashley, Ken I. and Lawrence, Gregory A. and WÜest, Alfred},
